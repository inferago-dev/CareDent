{
  "name": "caredent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js",
    "build": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build && npm run seo:meta",
    "lint": "eslint .",
    "preview": "vite preview",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "seo:meta": "node scripts/prerender-meta.mjs",
    "prebuild": "npm run check:domain && npm run sitemap",
    "check:domain": "node scripts/check-domain-parity.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "vite": "^8.2.0"
  }
}
