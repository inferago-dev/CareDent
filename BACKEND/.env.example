# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Database ----
# Local:  mongodb://127.0.0.1:27017/caredent
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/caredent
MONGODB_URI=mongodb://127.0.0.1:27017/caredent

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Seed admin (used by `npm run seed`) ----
ADMIN_EMAIL=admin@caredent.com
ADMIN_PASSWORD=CareDent@2025
ADMIN_NAME=Sivakumar

# ---- Email notifications (optional; leave blank to disable) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Care Dent <no-reply@caredent.com>"
# Where enquiry/quote/ticket notifications are sent
NOTIFY_EMAIL=jashvish.siva@gmail.com

# ---- Uploads ----
MAX_UPLOAD_MB=10
